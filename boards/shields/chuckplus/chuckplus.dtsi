#include <dt-bindings/zmk/matrix_transform.h>
#include "chuckplus-layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &chuckplus_layout22;
    };

    chuckplus_transform_22: keymap_transform_22 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <7>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)                                         RC(3,3) RC(3,2) RC(3,1) RC(3,0)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)                         RC(4,4) RC(4,3) RC(4,2) RC(4,1) RC(4,0)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)         RC(4,5)         RC(5,4) RC(5,3) RC(5,2) RC(5,1) RC(5,0)
                                            RC(6,0) RC(6,1)         RC(6,3) RC(6,4)
                                                RC(2,5) RC(1,5) RC(3,5) RC(0,5)
        >;
    };

    chuckplus_transform_21: keymap_transform_21 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <7>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)                                         RC(3,3) RC(3,2) RC(3,1) RC(3,0)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)                         RC(4,4) RC(4,3) RC(4,2) RC(4,1) RC(4,0)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)         RC(4,5)         RC(5,4) RC(5,3) RC(5,2) RC(5,1) RC(5,0)
                                            RC(6,0) RC(6,1)         RC(6,3)
                                                RC(2,5) RC(1,5) RC(3,5) RC(0,5)
        >;
    };

    chuckplus_transform_12: keymap_transform_12 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <7>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)                                         RC(3,3) RC(3,2) RC(3,1) RC(3,0)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)                         RC(4,4) RC(4,3) RC(4,2) RC(4,1) RC(4,0)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)         RC(4,5)         RC(5,4) RC(5,3) RC(5,2) RC(5,1) RC(5,0)
                                                    RC(6,1)         RC(6,3) RC(6,4)
                                                RC(2,5) RC(1,5) RC(3,5) RC(0,5)
        >;
    };

    chuckplus_transform_11: keymap_transform_11 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <7>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)                                         RC(3,3) RC(3,2) RC(3,1) RC(3,0)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)                         RC(4,4) RC(4,3) RC(4,2) RC(4,1) RC(4,0)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)         RC(4,5)         RC(5,4) RC(5,3) RC(5,2) RC(5,1) RC(5,0)
                                                    RC(6,1)         RC(6,3)
                                                RC(2,5) RC(1,5) RC(3,5) RC(0,5)
        >;
    };

    encoder: encoder {
        compatible = "alps,ec11";
        // Eh, the rkjxt seems to have A and B pulses opposite of the EC11,
        // so we lie about which is which so we get clockwise to be clockwise
        a-gpios = <&xiao_d 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&xiao_d 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <2>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <1>;
    };
};

// vim: expandtab softtabstop=4 shiftwidth=4
