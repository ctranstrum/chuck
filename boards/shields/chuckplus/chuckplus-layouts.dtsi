#include <physical_layouts.dtsi>

/ {
    chuckplus_layout22: chuckplus_layout_22 {
        compatible = "zmk,physical-layout";
        display-name = "Chuck Plus";

        transform = <&chuckplus_transform_22>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100   54   49    1500   104    99> // Q
            , <&key_physical_attrs 100 100  167   16    1500   217    66> // W
            , <&key_physical_attrs 100 100  297    0    2000   347    50> // F
            , <&key_physical_attrs 100 100  382   84    2250   432   134> // P
            , <&key_physical_attrs 100 100  691   84 (-2250)   741   134> // L
            , <&key_physical_attrs 100 100  776    0 (-2000)   826    50> // U
            , <&key_physical_attrs 100 100  906   16 (-1500)   956    66> // Y
            , <&key_physical_attrs 100 100 1018   49 (-1500)  1068    99> // '
            , <&key_physical_attrs 100 100   17  158    1000    67   208> // A
            , <&key_physical_attrs 100 100  141  113    1500   191   163> // R
            , <&key_physical_attrs 100 100  263   94    2000   313   144> // S
            , <&key_physical_attrs 100 100  343  177    2250   394   227> // T
            , <&key_physical_attrs 100 100  449  184    2250   499   234> // G
            , <&key_physical_attrs 100 100  624  184 (-2250)   674   234> // M
            , <&key_physical_attrs 100 100  729  177 (-2250)   779   227> // N
            , <&key_physical_attrs 100 100  810   94 (-2000)   860   144> // E
            , <&key_physical_attrs 100 100  932  113 (-1500)   982   163> // I
            , <&key_physical_attrs 100 100 1055  158 (-1000)  1105   208> // O
            , <&key_physical_attrs 100 100    0  257    1000    50   307> // Z
            , <&key_physical_attrs 100 100  115  209    1500   165   259> // X
            , <&key_physical_attrs 100 100  228  188    2000   278   238> // C
            , <&key_physical_attrs 100 100  305  269    2250   355   319> // D
            , <&key_physical_attrs 100 100  410  277    2250   460   327> // V
            , <&key_physical_attrs  50  50  560  380       0     0     0> // push
            , <&key_physical_attrs 100 100  662  277 (-2250)   712   327> // K
            , <&key_physical_attrs 100 100  767  269 (-2250)   817   319> // H
            , <&key_physical_attrs 100 100  844  188 (-2000)   894   238> // ,
            , <&key_physical_attrs 100 100  957  209 (-1500)  1007   259> // .
            , <&key_physical_attrs 100 100 1072  257 (-1000)  1122   307> // /
            , <&key_physical_attrs 100 100  366  384    3750   416   434> // -
            , <&key_physical_attrs 100 100  445  444    3750   495   494> // shift
            , <&key_physical_attrs 100 100  627  444 (-3750)   677   494> // space
            , <&key_physical_attrs 100 100  706  384 (-3750)   756   434> // *
            , <&key_physical_attrs  50  50  560  300       0     0     0> // up
            , <&key_physical_attrs  50  50  480  380       0     0     0> // left
            , <&key_physical_attrs  50  50  640  380       0     0     0> // right
            , <&key_physical_attrs  50  50  560  460       0     0     0> // down
            ;
    };

